# Server
PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/queue
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Public URL of the web app (must match the browser address, used for CORS and origin checks)
CLIENT_URL=http://localhost:5173

# Email (Gmail App Password). Leave blank in development to print codes in the server console.
GMAIL_USER=
GMAIL_APP_PASSWORD=
DEV_LOG_OTP=true

# Uploaded requirement images
UPLOAD_DIR=./uploads

# Production behind a reverse proxy or platform load balancer
TRUST_PROXY=false
# Set to true only when the site is served over HTTPS
HTTPS=false

# Used by npm run seed (development demo data only)
STAFF_EMAIL=staff@example.com
ADMIN_EMAIL=admin@example.com
